{
	"$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"ignore": []
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"organizeImports": {
		"enabled": true
	},
	"linter": {
		"enabled": true,
		"rules": {
			"all": true,
			"suspicious": {
				"noConsole": "off",
				"noConsoleLog": "off"
			},
			"correctness": { "noNodejsModules": "off" },
			"style": {
				"useNamingConvention": {
					"level": "info",
					"options": {
						"strictCase": false
					}
				},
				"useFilenamingConvention": {
					"level": "warn",
					"options": { "strictCase": false }
				}
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "asNeeded"
		}
	}
}
